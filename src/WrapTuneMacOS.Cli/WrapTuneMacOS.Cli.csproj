<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The binary users type. Assembly/namespace keep the project name. -->
    <AssemblyName>wraptune</AssemblyName>
    <RootNamespace>WrapTuneMacOS.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WrapTuneMacOS.Packaging\WrapTuneMacOS.Packaging.csproj" />
    <ProjectReference Include="..\WrapTuneMacOS.Signing\WrapTuneMacOS.Signing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WrapTuneMacOS.Cli.Tests" />
  </ItemGroup>

</Project>
