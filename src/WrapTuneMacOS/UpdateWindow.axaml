<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WrapTuneMacOS.UpdateWindow"
        Title="Update Available"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}"
        FontFamily="Inter" FontSize="13">

    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentOn}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.quiet">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- Low-emphasis text links (Release page / Skip): no border, so they recede
             instead of competing with the Later / Install decision buttons. -->
        <Style Selector="Button.link">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.link:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        </Style>
    </Window.Styles>

    <StackPanel Margin="24" Spacing="14">

        <TextBlock x:Name="TxtTitle" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource Fg}" TextWrapping="Wrap"/>

        <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <SelectableTextBlock x:Name="TxtNotes" FontSize="12.5"
                                 Foreground="{DynamicResource Dim}" TextWrapping="Wrap"/>
        </ScrollViewer>

        <ProgressBar x:Name="Bar" IsVisible="False" Minimum="0" Maximum="1" Height="6"/>

        <TextBlock x:Name="TxtUpdStatus" IsVisible="False" FontSize="12"
                   Foreground="{DynamicResource Dim}" TextWrapping="Wrap"/>

        <!-- Footer. The decision pair (Later / Install) is the only real button row.
             Release page / Skip sit above as borderless text links so they recede
             instead of reading as four crowded boxes. Two rows keep the primary
             action from clipping on this narrow fixed-width dialog. -->
        <StackPanel Spacing="6" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                <Button Classes="link" Content="Release page ↗" Click="OnOpenReleasePage"/>
                <Button Classes="link" Content="Skip this version" Click="OnSkip"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button x:Name="BtnLater" Classes="quiet" Content="Later" IsCancel="True" Click="OnLater"/>
                <Button x:Name="BtnInstall" Classes="primary" Content="Install &amp; Relaunch"
                        IsDefault="True" Click="OnInstall"/>
            </StackPanel>
        </StackPanel>

    </StackPanel>
</Window>
