<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>WrapTuneMacOS</RootNamespace>
    <AssemblyName>WrapTuneMacOS</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Space Grotesk + JetBrains Mono (both OFL; licenses alongside the .ttf files). -->
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WrapTuneMacOS.Packaging\WrapTuneMacOS.Packaging.csproj" />
    <ProjectReference Include="..\WrapTuneMacOS.Signing\WrapTuneMacOS.Signing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests exercise internal seams (e.g. the AppSettings folder override). -->
    <InternalsVisibleTo Include="WrapTuneMacOS.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
  </ItemGroup>

</Project>
