<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WrapTuneMacOS.MainWindow"
        Title="WrapTune"
        Width="720" Height="600" MinWidth="640" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        FontFamily="Inter" FontSize="13">

    <!-- macOS menu bar. Avalonia only populates it when a NativeMenu is declared —
         without this block the app shows just the bare app menu. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="File">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Choose Source Folder…" Gesture="Meta+O" Click="MenuBrowseSource"/>
                        <NativeMenuItem Header="Choose Setup File…" Gesture="Meta+Shift+O" Click="MenuBrowseSetup"/>
                        <NativeMenuItem Header="Choose Output Folder…" Click="MenuBrowseOutput"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Package" Gesture="Meta+R" Click="MenuPackage"/>
                        <NativeMenuItem Header="Open Output Folder" Click="MenuOpenOutput"/>
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Edit">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Cut" Gesture="Meta+X" Click="OnEditCut"/>
                        <NativeMenuItem Header="Copy" Gesture="Meta+C" Click="OnEditCopy"/>
                        <NativeMenuItem Header="Paste" Gesture="Meta+V" Click="OnEditPaste"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Select All" Gesture="Meta+A" Click="OnEditSelectAll"/>
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Window">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Minimize" Gesture="Meta+M" Click="OnWindowMinimize"/>
                        <NativeMenuItem Header="Zoom" Click="OnWindowZoom"/>
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Help">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="WrapTune on GitHub" Click="OnHelpGitHub"/>
                        <NativeMenuItem Header="Report an Issue" Click="OnHelpIssue"/>
                        <NativeMenuItem Header="Release Notes" Click="OnHelpReleases"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Check for Updates…" Click="OnCheckForUpdates"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="About WrapTune" Click="OnHelpAbout"/>
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <Window.Styles>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style Selector="TextBlock.fieldHint">
            <Setter Property="Foreground" Value="{DynamicResource Dimmer}"/>
            <Setter Property="FontFamily" Value="Menlo"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style Selector="TextBox.path">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontFamily" Value="Menlo"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0,8,0"/>
            <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
        </Style>
        <Style Selector="Button.browse">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Content" Value="…"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource Panel2Bg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentOn}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.toggle">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="TextBlock.signLabel">
            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Collapsible section header + body, themed to match the rest of the app
             (avoids the Fluent Expander's own dark chrome). -->
        <Style Selector="Button.section">
            <Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.section:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Panel2Bg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style Selector="Border.sectionBody">
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </Window.Styles>

    <Grid Margin="24" RowDefinitions="Auto,*,Auto">

        <!-- 0 · Header (pinned) -->
        <Grid Grid.Row="0" Margin="0,0,0,14" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0">
                <TextBlock Text="New package" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource Fg}"/>
                <TextBlock Margin="0,3,0,0" FontSize="12.5" Foreground="{DynamicResource Dim}">
                    <Run Text="Wrap a Win32 installer into an "/>
                    <Run FontFamily="Menlo" Foreground="{DynamicResource Accent}" Text=".intunewin"/>
                    <Run Text=" package for Microsoft Intune."/>
                </TextBlock>
            </StackPanel>
            <Button x:Name="BtnTheme" Grid.Column="1" Classes="toggle"
                    Content="◐ Dark" Click="BtnTheme_Click" VerticalAlignment="Top"/>
        </Grid>

        <!-- Scrollable body — keeps the footer (Package) pinned even when the
             optional signing section is expanded taller than the window. -->
        <ScrollViewer Grid.Row="1" Margin="0,0,0,14"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

        <!-- Built-in engine pill (replaces WrapTune's exe-path row) -->
        <Border Margin="0,0,0,16"
                Background="{DynamicResource AccentSoft}"
                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Fg}"
                           Text="Built-in .intunewin engine"/>
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="11.5" Foreground="{DynamicResource Dim}"
                           Text="— no external tool needed"/>
            </StackPanel>
        </Border>

        <!-- Form rows -->
        <Grid ColumnDefinitions="128,*,Auto" RowDefinitions="Auto,Auto,Auto">

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,10" VerticalAlignment="Center">
                <TextBlock Classes="fieldLabel" Text="Source folder"/>
                <TextBlock Classes="fieldHint" Text="-c"/>
            </StackPanel>
            <TextBox x:Name="TxtSourceFolder" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                     Classes="path" DragDrop.AllowDrop="True"
                     Watermark="Folder whose contents get packaged"/>
            <Button x:Name="BtnBrowseSource" Grid.Row="0" Grid.Column="2" Margin="6,0,0,10"
                    Classes="browse" Click="BtnBrowseSource_Click"/>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,14,10" VerticalAlignment="Center">
                <TextBlock Classes="fieldLabel" Text="Setup file"/>
                <TextBlock Classes="fieldHint" Text="-s"/>
            </StackPanel>
            <TextBox x:Name="TxtSetupFile" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                     Classes="path" DragDrop.AllowDrop="True"
                     Watermark="The installer inside the source folder"/>
            <Button x:Name="BtnBrowseSetup" Grid.Row="1" Grid.Column="2" Margin="6,0,0,10"
                    Classes="browse" Click="BtnBrowseSetup_Click"/>

            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock Classes="fieldLabel" Text="Output folder"/>
                <TextBlock Classes="fieldHint" Text="-o"/>
            </StackPanel>
            <TextBox x:Name="TxtOutputFolder" Grid.Row="2" Grid.Column="1"
                     Classes="path" DragDrop.AllowDrop="True"
                     Watermark="Where the .intunewin is written"/>
            <Button x:Name="BtnBrowseOutput" Grid.Row="2" Grid.Column="2" Margin="6,0,0,0"
                    Classes="browse" Click="BtnBrowseOutput_Click"/>
        </Grid>

        <!-- Overwrite toggle -->
        <CheckBox x:Name="ChkOverwrite" Margin="142,14,0,16" IsChecked="True"
                  Foreground="{DynamicResource Fg}" FontSize="12.5">
            <TextBlock>
                <Run Text="Overwrite existing output "/>
                <Run FontFamily="Menlo" Foreground="{DynamicResource Dimmer}" FontSize="11" Text="-q"/>
            </TextBlock>
        </CheckBox>

        <!-- Code signing (optional) — custom collapsible, themed to match the app -->
        <StackPanel Margin="0,0,0,14">
            <Button x:Name="BtnSignToggle" Classes="section" Click="BtnSignToggle_Click">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Code signing — optional"
                               VerticalAlignment="Center" FontSize="12.5" FontWeight="Medium"
                               Foreground="{DynamicResource Fg}"/>
                    <TextBlock x:Name="SignChevron" Grid.Column="1" Text="⌄"
                               VerticalAlignment="Center" FontSize="14"
                               Foreground="{DynamicResource Dim}"/>
                </Grid>
            </Button>
            <Border x:Name="SignBody" Classes="sectionBody" IsVisible="False">
                <StackPanel Spacing="10">
                <CheckBox x:Name="ChkSignPayload" IsCheckedChanged="ChkSignPayload_IsCheckedChanged"
                          Foreground="{DynamicResource Fg}" FontSize="12.5">
                    <TextBlock Text="Authenticode-sign the payload before packaging"/>
                </CheckBox>

                <StackPanel x:Name="SigningFields" Spacing="10">
                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource Dim}"
                               Text="Signs files in place; already-signed files are skipped. Signing runs in-process — nothing extra to install."/>

                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <RadioButton x:Name="RbPfx" GroupName="certMode" IsChecked="True"
                                     IsCheckedChanged="RbCertMode_IsCheckedChanged"
                                     Content="PFX / .p12 file" Foreground="{DynamicResource Fg}" FontSize="12.5"/>
                        <RadioButton x:Name="RbPkcs11" GroupName="certMode"
                                     IsCheckedChanged="RbCertMode_IsCheckedChanged"
                                     Content="PKCS#11 token / HSM" Foreground="{DynamicResource Fg}" FontSize="12.5"/>
                        <RadioButton x:Name="RbTrustedSigning" GroupName="certMode"
                                     IsCheckedChanged="RbCertMode_IsCheckedChanged"
                                     Content="Azure Artifact Signing" Foreground="{DynamicResource Fg}" FontSize="12.5"
                                     ToolTip.Tip="Azure Artifact Signing (formerly Trusted Signing) — cloud HSM signing; the key never leaves Azure."/>
                    </StackPanel>

                    <!-- PFX -->
                    <Grid x:Name="PanelPfx" ColumnDefinitions="120,*,Auto">
                        <TextBlock Grid.Column="0" Classes="signLabel" Text="Certificate"/>
                        <TextBox x:Name="TxtPfxPath" Grid.Column="1" Classes="path"
                                 Watermark="Path to .pfx / .p12"/>
                        <Button x:Name="BtnBrowsePfx" Grid.Column="2" Margin="6,0,0,0"
                                Classes="browse" Click="BtnBrowsePfx_Click"/>
                    </Grid>

                    <!-- PKCS#11 -->
                    <StackPanel x:Name="PanelPkcs11" Spacing="8" IsVisible="False">
                        <Grid ColumnDefinitions="120,*,Auto">
                            <TextBlock Grid.Column="0" Classes="signLabel" Text="Module"/>
                            <TextBox x:Name="TxtPkcs11Module" Grid.Column="1" Classes="path"
                                     Watermark="PKCS#11 module (.dylib / .so)"/>
                            <Button x:Name="BtnBrowsePkcs11" Grid.Column="2" Margin="6,0,0,0"
                                    Classes="browse" Click="BtnBrowsePkcs11_Click"/>
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Classes="signLabel" Text="Thumbprint"/>
                            <TextBox x:Name="TxtPkcs11Thumbprint" Grid.Column="1" Classes="path"
                                     Watermark="Certificate thumbprint — optional when the token holds one cert"
                                     ToolTip.Tip="Only needed to pick a certificate when the token holds several. Leave blank when it holds exactly one."/>
                        </Grid>
                    </StackPanel>

                    <!-- Azure Artifact Signing (jsign) -->
                    <StackPanel x:Name="PanelTrustedSigning" Spacing="8" IsVisible="False">
                        <!-- Live prerequisites callout: signer, token source, and the RBAC role. -->
                        <Border Background="{DynamicResource Panel2Bg}"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="10,8">
                            <TextBlock x:Name="TxtTsPrereq" TextWrapping="Wrap" FontSize="11.5"
                                       LineHeight="17" Foreground="{DynamicResource Dim}"/>
                        </Border>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Classes="signLabel" Text="Endpoint"/>
                            <TextBox x:Name="TxtTsEndpoint" Grid.Column="1" Classes="path"
                                     Watermark="e.g. eus.codesigning.azure.net"
                                     ToolTip.Tip="Your account's region host. In the Azure portal, open your Artifact Signing account → Overview → copy the &quot;Account URI&quot; (e.g. https://eus.codesigning.azure.net/). The https:// and trailing slash are optional — WrapTune strips them."/>
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Classes="signLabel" Text="Account"/>
                            <TextBox x:Name="TxtTsAccount" Grid.Column="1" Classes="path"
                                     Watermark="Artifact Signing account name"
                                     ToolTip.Tip="The name of your Artifact Signing account resource (Azure portal → the account's name, or the codeSigningAccounts resource name)."/>
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Classes="signLabel" Text="Cert profile"/>
                            <TextBox x:Name="TxtTsProfile" Grid.Column="1" Classes="path"
                                     Watermark="Certificate profile name"
                                     ToolTip.Tip="The certificate profile under your account: Azure portal → your Artifact Signing account → Certificate profiles → the profile name."/>
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Classes="signLabel" Text="Access token"/>
                            <TextBox x:Name="TxtTsToken" Grid.Column="1" Classes="path" PasswordChar="•"
                                     Watermark="Blank = auto-fetch via Azure CLI (az login)"
                                     ToolTip.Tip="Leave blank to auto-fetch a fresh token via the Azure CLI (run az login first). Or paste one from: az account get-access-token --resource https://codesigning.azure.net --query accessToken -o tsv"/>
                        </Grid>
                    </StackPanel>

                    <Grid x:Name="RowSecret" ColumnDefinitions="120,*">
                        <TextBlock Grid.Column="0" Classes="signLabel" Text="Password / PIN"/>
                        <TextBox x:Name="TxtSecret" Grid.Column="1" Classes="path" PasswordChar="•"
                                 Watermark="Not saved — entered each run"/>
                    </Grid>

                    <Grid x:Name="RowTimestamp" ColumnDefinitions="120,*">
                        <TextBlock Grid.Column="0" Classes="signLabel" Text="Timestamp URL"/>
                        <TextBox x:Name="TxtTimestampUrl" Grid.Column="1" Classes="path"
                                 Watermark="RFC3161 timestamp server (blank to skip)"/>
                    </Grid>

                    <Grid ColumnDefinitions="120,*">
                        <TextBlock Grid.Column="0" Classes="signLabel" Text="Description"/>
                        <TextBox x:Name="TxtSignDescription" Grid.Column="1" Classes="path"
                                 Watermark="Signature description (optional)"/>
                    </Grid>

                    <Grid ColumnDefinitions="120,*">
                        <TextBlock Grid.Column="0" Classes="signLabel" Text="URL"/>
                        <TextBox x:Name="TxtSignUrl" Grid.Column="1" Classes="path"
                                 Watermark="Signature URL (optional)"/>
                    </Grid>

                    <CheckBox x:Name="ChkSignAllFiles" Foreground="{DynamicResource Fg}" FontSize="12.5">
                        <TextBlock Text="Also sign other signable files in the source folder"/>
                    </CheckBox>
                </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Output log -->
        <Border MinHeight="150" MaxHeight="280"
                Background="{DynamicResource LogBg}"
                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                CornerRadius="8">
            <TextBox x:Name="TxtOutput"
                     Background="Transparent" BorderThickness="0"
                     IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     FontFamily="Menlo" FontSize="11.5"
                     Foreground="{DynamicResource Dim}" Padding="12"/>
        </Border>

        </StackPanel>
        </ScrollViewer>

        <!-- Footer (pinned) -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto">
            <TextBlock x:Name="TxtStatus" Grid.Column="0" Text="Ready"
                       VerticalAlignment="Center" FontSize="11.5"
                       Foreground="{DynamicResource Dimmer}"/>
            <Button x:Name="BtnOpenOutput" Grid.Column="1" Margin="0,0,10,0"
                    Classes="secondary" Content="Open output" IsVisible="False"
                    Click="BtnOpenOutput_Click"/>
            <Button x:Name="BtnCancel" Grid.Column="2" Margin="0,0,10,0"
                    Classes="secondary" Content="Cancel" IsVisible="False"
                    Click="BtnCancel_Click"/>
            <Button x:Name="BtnPackage" Grid.Column="3" Classes="primary"
                    Content="Package" Click="BtnPackage_Click"/>
        </Grid>
    </Grid>
</Window>
