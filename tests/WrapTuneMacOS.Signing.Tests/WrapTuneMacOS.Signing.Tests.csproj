<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WrapTuneMacOS.Signing\WrapTuneMacOS.Signing.csproj" />
    <!-- The compose test signs a payload and then wraps it with the real engine. -->
    <ProjectReference Include="..\..\src\WrapTuneMacOS.Packaging\WrapTuneMacOS.Packaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tiny real MSI (msitools-generated, from the MacSign repo) for the
         MSI-signing end-to-end test. -->
    <Content Include="fixtures\test.msi" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
